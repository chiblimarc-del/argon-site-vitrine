# =============================================================================
# Variables de BUILD du site Argon.
#
# ⚠️ Ce fichier ne contient plus aucun secret. Depuis le passage en export
# statique, il n'y a aucun processus Node en production : les identifiants
# Mailjet vivent désormais dans `deploy/api/config.php`, créé directement sur
# le serveur OVH (voir deploy/api/config.example.php).
# =============================================================================

# URL absolue du site, sans slash final.
# Sert aux canonical, au sitemap, à robots.txt et aux URLs Open Graph.
#
# ⚠️ Toute valeur autre que le domaine de production bascule robots.txt en
# « Disallow: / ». C'est volontaire — un environnement de test ne doit jamais
# être indexé — mais cela signifie qu'un build lancé avec cette valeur produit
# un site invisible de Google. `npm run deploy:build` force la bonne valeur, et
# `npm run deploy:pack` refuse d'assembler un paquet dans cet état.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Ouverture aux moteurs de recherche. FERMÉ par défaut.
#
# ⚠️ Question INDÉPENDANTE du domaine ci-dessus. Le site est déployé sur son
# domaine définitif AVANT d'être ouvert : les pages légales ne sont pas prêtes,
# et un site professionnel indexé sans mentions légales est en infraction.
#
# Ne pas régler cette variable à la main pour un déploiement : utiliser
# `npm run deploy:build` (fermé) ou `npm run deploy:ouvrir` (ouvert). Les deux
# synchronisent l'en-tête HTTP du .htaccess avec les balises meta des pages, et
# refusent de produire un paquet incohérent.
NEXT_PUBLIC_SITE_OPEN=false
