# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …sauf le modèle documenté, qui ne contient aucun secret et doit être versionné.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Secrets Mailjet : créés directement sur le serveur, jamais versionnés.
deploy/api/config.php

# Les trois fichiers que `npm run apercu` fait vivre à la racine du dépôt.
#
#   argon-config.php   la configuration locale du formulaire. Même nom qu'en
#                      production, où il vit au-dessus de la racine web. Il
#                      porte des clés : jamais dans un commit.
#   argon-limites.php  le compteur d'envois, que demande.php écrit à côté de sa
#                      configuration. Généré, jamais écrit à la main — le
#                      supprimer remet le quota à zéro.
#   argon-journal.log  le journal du formulaire. C'est lui qui dit ce qui s'est
#                      réellement passé : refuse, silence, succes.
/argon-config.php
/argon-limites.php
/argon-journal.log

# Documents du projet.
# Le document d'amorcage et les audits sont VERSIONNES : un depot qui ne les porte pas
# n'apprend rien a la session qui le clone. Les comptes rendus de lot et les regles
# restent des copies locales du projet claude.ai, qui fait foi pour eux.
/claude/*
!/claude/etat-du-projet.md
!/claude/audit-2026-08-26.md
!/claude/audit-2026-08-31.md
!/claude/etude-raccord-crm-2026-09-01.md
!/claude/plan-raccord-crm-2026-09-01.md
/_to_delete/
